{
  "name": "py-micro-superpowers",
  "version": "4.2.0",
  "description": "Superpowers for Python microservices \u2014 Django, FastAPI, pytest, PostgreSQL review agents and skills built on the superpowers plugin. 25 agents, 17 commands, 21 skills, 1 MCP server.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/check-dependencies.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "author": {
    "name": "BaronVonSario",
    "email": "cesar.gon.fer@gmail.com",
    "url": "https://github.com/BaronVonSario"
  },
  "repository": "https://github.com/weorbitant/compound-engineering-feat-python-plugin",
  "license": "MIT",
  "keywords": [
    "superpowers",
    "python",
    "microservices",
    "django",
    "fastapi",
    "pytest",
    "pydantic",
    "postgresql",
    "code-review",
    "ai-powered"
  ],
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    }
  }
}
